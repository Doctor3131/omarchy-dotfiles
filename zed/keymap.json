// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "space space": [
        "task::Spawn",
        {
          // "task_name": "Television File Finder (Dirs)",
          "task_name": "Television File Finder",
          "reveal_target": "center",
        },
      ],
      "space f f": [
        "task::Spawn",
        {
          // "task_name": "Television File Finder (Root)",
          "task_name": "Television File Finder",
          "reveal_target": "center",
        },
      ],
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "; f": [
        "task::Spawn",
        {
          "task_name": "Television File Finder",
          "reveal_target": "center",
        },
      ],
      "s f": [
        "task::Spawn",
        {
          "task_name": "Television File Finder",
          "reveal_target": "center",
        },
      ],
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      // "space b": "git::Blame",
      "shift-k": "editor::Hover",
      // "space l f": "editor::Format",
      // "space d": "diagnostics::Deploy",

      // "; f": "file_finder::Toggle",
      // "s f": "file_finder::Toggle",
      // "space space": "file_finder::Toggle",
      "\\ \\": "tab_switcher::Toggle",
      "; ;": "tab_switcher::Toggle",

      // "space o": "tab_switcher::Toggle",
      "n": "search::SelectNextMatch",
      "shift-n": "search::SelectPreviousMatch",
      // "space t": "workspace::NewCenterTerminal",
      "g c": "editor::ToggleComments",
      "+ +": "workspace::Save",
      // "space c": "pane::CloseActiveItem",
      "ctrl-a": "editor::SelectAll",
      "s s": "pane::SplitRight",
      "s v": "pane::SplitDown",
      "s h": "workspace::ActivatePaneLeft",
      "s l": "workspace::ActivatePaneRight",
      "s k": "workspace::ActivatePaneUp",
      "s j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !VimObject",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "(Dock || Terminal || Editor) && vim_mode == normal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      // "ctrl-l": "workspace::ActivatePaneRight",
      // "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-alt-a": "workspace::ToggleRightDock",
      "space e": "workspace::ToggleLeftDock",
      "space /": "workspace::NewSearch",
    },
  },
  {
    "context": "Dock || Terminal || Editor",
    "bindings": {
      // "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      // "ctrl-j": "workspace::ActivatePaneDown",
      // "ctrl-alt-a": "workspace::ToggleRightDock",
      // "space e": "workspace::ToggleLeftDock",
      // "space /": "workspace::NewSearch",
    },
  },
]
